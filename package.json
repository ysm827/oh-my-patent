{
  "name": "oh-my-patent",
  "version": "0.3.0",
  "description": "Patent disclosure drafting workflow with brainstorm path tracking",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "oh-my-patent": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npx tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run build && npm test"
  },
  "keywords": [
    "patent",
    "ai",
    "brainstorm",
    "cli"
  ],
  "author": "oh-my-patent contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/illusionaireal/oh-my-patent.git"
  },
  "homepage": "https://github.com/illusionaireal/oh-my-patent#readme",
  "bugs": {
    "url": "https://github.com/illusionaireal/oh-my-patent/issues"
  },
  "files": [
    "dist/",
    "src/",
    "plugin.jsonc",
    "opencode.jsonc.example",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "ink": "^7.0.2",
    "react": "^19.2.6"
  }
}
